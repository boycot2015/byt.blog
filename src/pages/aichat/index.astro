---
import PageLayout from "@/layouts/Base.astro";

const title = '我是 DeepSeek，很高兴见到你！'
const subTitle = '我可以帮你写代码、读文件、写作各种创意内容，请把你的任务交给我吧~'
const meta = {
	description: "我是 DeepSeek，很高兴见到你！",
	title: "ai chat",
};

---

<PageLayout meta={meta}>
    <main class="main pace-y-2 sm:space-y-8 mx-auto flex flex-col items-center justify-center overflow-y-auto">
      <h1 class="text-center text-xl">{title}</h1>
      <h3>{subTitle}</h3>
      <section class="flex flex-col min-h-[52vh] sm:min-h-[35vh] w-full">
        <div class={`flex flex-1 flex-col rounded-md w-full overflow-y-auto`} id="response-content"></div>
        <div class="action-btns mt-4 flex w-full flex-wrap sm:space-x-2">
            <input id="submit-text" class="border mb-2 sm:mb-0 w-full sm:flex-1 p-2 rounded-md border-[var(--color-border)]" type="text" placeholder="给DeepSeek发消息">
            <div class="flex w-full sm:w-[auto] justify-center">
              <button id="submit-btn" class="cursor-pointer self-end sm:w-[30%] mr-2 sm:w-[auto] border text-[var(--color-accent)] p-2 rounded-md border-[var(--color-border)]">提交</button>
              <button id="reset-btn" class="cursor-pointer sm:w-[30%] sm:m-[auto] sm:w-[auto] border text-[var(--color-global-text)] bg-[var(--color-bg)] p-2 rounded-md border-[var(--color-border)]">清除</button>
            </div>
        </div>
      </section>
    </main>
</PageLayout>
<script>
import { marked } from 'marked'
import { markedHighlight } from 'marked-highlight'
import { uuid, debounce } from '@/utils'
import prism from "prismjs";
import { siteConfig } from "@/site.config";

window.Prism = prism

import "prismjs/plugins/line-numbers/prism-line-numbers.js";
import "prismjs/plugins/line-numbers/prism-line-numbers.css";

import "prismjs/plugins/toolbar/prism-toolbar.js"; // required for the following plugins
import "prismjs/plugins/toolbar/prism-toolbar.css"; // required for the following plugins
import "prismjs/plugins/copy-to-clipboard/prism-copy-to-clipboard.js"; // show copy button
import "prismjs/plugins/show-language/prism-show-language.js"; // display the language of the code block
import "prismjs/plugins/custom-class/prism-custom-class";

let apiUrl = siteConfig.apiUrl
let renderer = new marked.Renderer();

renderer.code = function(code, lang, escaped) {
    if (this.options.highlight) {
        var out = this.options.highlight(code, lang);
        //if (out != null && out !== code) {  [*3]
        if (out != null) {
            escaped = true;
            code = out;
        }
    }

    if (!lang) {
        return `<pre class="${this.options.langPrefix}PLACEHOLDER"><code>`
            // + (escaped ? code : escape(code, true)) [1]
            + code
            + '\n</code></pre>';
    }

    let langText = this.options.langPrefix + escape(lang);
    return `<pre class="${langText}"><code class="${langText}">` // [2]
        + (escaped ? code : escape(code))
        + '\n</code></pre>\n';
};
marked.use(markedHighlight({
  langPrefix: 'prism line-numbers language-',
  highlight: (code, lang = 'html') => {
    if (prism.languages[lang]) {
      return prism.highlight(code, prism.languages[lang], lang);
    } else {
      return code;
    }
  },
}))
document.addEventListener('astro:page-load', () => {
  let isBottom: boolean = true
  let isRuning: boolean = false
  let timeCount: number = 0
  let timeout: any
  let timer: any
  let isExpand = true
  const btn = document.querySelector('#submit-btn') as HTMLButtonElement
  const restBtn = document.querySelector('#reset-btn') as HTMLButtonElement
  const input = document.querySelector('#submit-text') as HTMLInputElement
  let container = document.querySelector('#response-content') as HTMLDivElement
  if (!btn || !restBtn || !input) return
  const getChatData = async () => {
      clearInterval(timeout)
      clearInterval(timer)
      const message = input?.value || ''
      if (!message) return
      const role = 'user'
      let messages:{id: string;role: string;content:string}[] = []
      let responseId = 'response-' + uuid()
      let output = '<p>深度思考中...</p>'
      let askId = 'ask-' + uuid()
      let html = ''
      let responseEl = document.querySelector(`#${responseId}`) as HTMLDivElement
      messages.push({ id: askId, role, content: message })
      messages.push({ id: responseId, role: 'deepseek', content: output })

      messages.map((el, i) => {
        html += `<div class="flex flex-col my-4">
            <span class="h-10 leading-10 border-[var(--color-border)] ${i %2!=0?'self-start':'self-end'}">${el.role}</span>
            <div class="relative p-3 flex rounded-md bg-[rgb(240,240,240)] dark:bg-[rgb(33,35,38)] text-[var(--color-global-text)] leading-6 ${i %2!=0?'min-h-12 flex-wrap':'self-end'}">
              <div class="response-${i %2==0?'user':'ai'}-content w-full overflow-x-auto" id="${el.id}">${el.content}${el.id === askId ?'<span class="text-[var(--color-accent)] ml-2 cursor-pointer float-right" id="'+el.id+'-eidt-btn">【编辑】</span>':''}</div>
            </div>
        </div>`
      })
      let contentEl = document.createElement('div')
      contentEl.innerHTML = html
      container.appendChild(contentEl)
      isRuning = true
      const controller = new AbortController();
      btn.innerHTML = 'loading...'
      restBtn.innerHTML = '暂停'
      const response = await fetch(`${apiUrl}/data`, {
        method: "post",
        signal: controller.signal,
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ search: message, role })
      })
      if (!response.body) return;
      timeout = setInterval(() => {
        timeCount++
      }, 1000)
      const reader = response.body.pipeThrough(new TextDecoderStream()).getReader()
      timer = setInterval(async () => {
        try {
          let { value, done } = await reader.read()
          value = value?.replace('undefined', '')
          output += value?.replace('undefined', '')
          responseEl = document.querySelector(`#${responseId}`) as HTMLDivElement
          if (output.includes('</think>')) {
            clearInterval(timeout)
            if (timeCount > 5) {
              let reasoningEl = document.createElement('div')
              let toolbar = `<p id="toggle-${responseId}"><span>已思考(${timeCount}秒)</span><span class="ml-2 text-[var(--color-accent)] cursor-pointer toggle-text">收起</span><p>`
              let content = marked.parse(output.replace('finish_reason=true', '').replace(/<\think> <\/think>/g, '')).replace('<p>深度思考中...</p>', '')
              reasoningEl.setAttribute('class', `flex flex-col mb-2`)
              reasoningEl.innerHTML = `${toolbar}<div class="px-2 w-full bg-[rgb(240,240,240)] dark:bg-[rgb(33,35,38)] border-l-4 border-[#ccc] dark:border-[#333] mb-3 text-[var(--color-global-text)] leading-6 response-ai-content w-full overflow-x-auto" id="response-ai-reasoning-${responseId}">${content}</div>`
              content && responseEl.before(reasoningEl)
            }
            output = ''
            let toggleBtn = document.querySelector(`#toggle-${responseId}`) as HTMLSpanElement
            toggleBtn.onclick = () => {
              isExpand = !isExpand
              let toggleText = toggleBtn.querySelector('.toggle-text') as HTMLSpanElement
              toggleText.innerHTML = isExpand ? '收起' : '展开'
              const reasoningEl = document.querySelector(`#response-ai-reasoning-${responseId}`) as HTMLDivElement
              reasoningEl.style.display = isExpand ? 'block' : 'none'
            }
            isExpand && toggleBtn.click()
          } else if (!output.includes('<think>')) {
            output = output.replace('<p>深度思考中...</p>', '')
          }
          responseEl.innerHTML = marked.parse('<span class="float-right bg-[rgb(240,240,240)] dark:bg-[rgb(33,35,38)] right-2 top-2 text-[var(--color-accent)] ml-2 cursor-pointer" id="'+responseId+'-copy-btn">【复制】</span>' + output.replace('finish_reason=true', '').replace(/undefined/g, '')) as string
          responseEl.setAttribute('data-text', output.replace('finish_reason=true', '').replace(/undefined/g, ''))
          prism.highlightAll()
          isBottom && window.scrollTo(0, document.body.scrollHeight)
          if (done || !isRuning || value?.includes('finish_reason=true')) {
              clearInterval(timer)
              btn.innerHTML = '提交'
              restBtn.innerHTML = '清除'
              isRuning = false
              controller.abort()
              let copyBtn = document.querySelector('#'+responseId+'-copy-btn') as HTMLDivElement
              copyBtn.onclick = () => {
                // document.execCommand('copy', false, responseEl.innerHTML)
                navigator.clipboard.writeText(responseEl.getAttribute('data-text') as string).then(function() {
                console.log('文本已复制到剪贴板!');
                copyBtn.innerHTML = '【copied!】'
                setTimeout(() => {
                  copyBtn.innerHTML = '【复制】'
                }, 2000);
                }).catch(function(err) {
                    console.error('复制失败:', err);
                });
              }
              return
          };
        } catch (error) {
        }
      }, 50)
      window.onscroll = debounce(() => {
        isBottom = document.body.scrollHeight - window.innerHeight === window.scrollY
      }, 10, false)
      let askBtn = document.querySelector('#'+askId+'-eidt-btn') as HTMLDivElement
      askBtn.onclick = () => {
        input.value = document.querySelector('#'+askId)?.firstChild?.nodeValue || ''
        window.scrollTo(0, document.body.scrollHeight)
        input.focus()
      }
  }
  
  const submit = () => {
    if (btn.innerText == 'loading...') {
      isRuning = false
      timeCount = 0
      btn.innerHTML = '提交'
      restBtn.innerHTML = '清除'
      return
    }
    let container = document.querySelector('#response-content') as HTMLDivElement
    container.scrollTo(0, container.scrollHeight)
    getChatData()
    input.value = ''
  }
  const reset = () => {
    restBtn.innerHTML = '清除'
    if (!isRuning) container.innerHTML = ''
    else submit()
  }
  btn.onclick = submit
  restBtn.onclick = reset
  window.addEventListener('keypress', e => {
    if (e.key == 'Enter') {
      submit()
    }
  })
})
</script>