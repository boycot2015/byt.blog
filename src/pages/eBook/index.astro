---
import PageLayout from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
const allbooks = await getCollection("ebook");
const meta = {
	description: "电子书、阅读",
	title: "电子书",
};
// console.log(allbooks, 'allbooks');
const data = allbooks.map(el => el.data)
---

<PageLayout meta={meta}>
    <div class="flex space-x-4">
        {
            data.map((item, index) => <a href={'/eBook/'+item.title}><div class="w-[120px] h-[180px] overflow-hidden mb-2" id={`book${index+1}`}>
            </div><h3 class="text-center">{item.title}-{item.author}</h3></a>)
        }
    </div>
    <div class="mt-6">
        获取更佳体验，访问<a href="https://web.koodoreader.com/" class="hover:text-global-text px-2 underline sm:py-0" target="_blank" rel="noopener noreferrer">koodoreader</a>
    </div>
</PageLayout>
<script>
import Epub from 'epubjs'
import frxxzbook from '@/assets/book/凡人修仙传_忘语_24hbook.epub'
import dpcqbook from '@/assets/book/斗破苍穹_天蚕土豆_24hbook.epub'
import xnbook from '@/assets/book/仙逆_耳根_24hbook.epub'
document.addEventListener('astro:page-load', () => {
    [xnbook, dpcqbook, frxxzbook].map(async (el, index) => {
        let book = Epub(el);
        // 读取EPUB文件
        await book.loaded;
        // 创建一个 Rendition，并指定要渲染 EPUB 的 HTML 元素
        const bookContainer = document.getElementById('book' + (index + 1));
        const rendition = book.renderTo(bookContainer, {
            width: '100%',
            height: '100%',
			allowScriptedContent: true
        });
    
        // 加载第一页
        rendition.display();
    })
})
</script>