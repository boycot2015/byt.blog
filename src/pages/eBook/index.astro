---
import PageLayout from "@/layouts/Base.astro";
import { getAllbooks } from "@/data/book";
const allbooks = await getAllbooks()

const meta = {
	description: "电子书、阅读",
	title: "电子书",
};
// console.log(allbooks, 'allbooks');
const data = allbooks.map(el => el.data)
const isPro = import.meta.env.PROD
---

<PageLayout meta={meta}>
    <div id="books" class="books grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {
            data.map((item, index) => <div id={`book${index+1}`}><a href={'/eBook/'+item.title}><div class={`w-full  overflow-hidden`}  title={`${item.title}-${item.author}`}>
            <img src={item.img} class="h-[230px] sm:h-[260px] lg:h-[160px] w-full" alt={item.title} />
            <h3 class="text-center line-clamp-1 mt-2">{item.title}-{item.author}</h3></div></a>
            {!isPro ? <div class="flex justify-center my-1"><button class="remove-btn border px-1 rounded-md text-[var(--color-accent)] border-[var(--color-accent)] cursor-pointer" data-object-id={item.objectId} data-id={`book${index+1}`}>删除</button></div> : null}
            </div>)
        }
        {
            !isPro ? <div class="add-btn cursor-pointer border border-[var(--color-accent)] px-10 text-[40px] w-[auto] justify-center items-center flex flex-col h-[230px] sm:h-[260px] lg:h-[160px] text-[var(--color-accent)]">
                +
                <span class="text-xl">上传</span>
                <input type="file" accept=".epub" hidden>
            </div> : null
        }
    </div>
    <div class="w-full">
        <!-- <iframe class="w-full h-full" src="https://byt-reader.vercel.app" frameborder="0"></iframe> -->
        <div class="mt-6">
            获取更佳体验，访问<a href="https://web.koodoreader.com/" class="hover:text-global-text px-2 underline sm:py-0" target="_blank" rel="noopener noreferrer">koodoreader</a>
        </div>
    </div>
</PageLayout>

<script>
    import { siteConfig } from '@/site.config'
    import localforage from 'localforage'
    import Epub from 'epubjs'
    import Loading from '@/utils/Loading'
    import Message from '@/utils/Message'

    const $api = siteConfig.$api;
    const loading = new Loading()
    const message = new Message()
    document.addEventListener('astro:page-load', () => {
        let targetEl = document.querySelector('.add-btn') as HTMLDivElement
        let fileEl = document.querySelector('input') as HTMLInputElement
        let bookEl = document.querySelector('#books') as HTMLDivElement
        targetEl && (targetEl.onclick = () => {
            fileEl.click()
        })
        bookEl && bookEl.addEventListener('click', (e:any) => {
            // console.log(e.target.tagName, 'e.target.tagName');
            if (e.target.tagName === 'BUTTON') {
                let target = e.target
                let id = target.getAttribute('data-id')
                let objectId = target.getAttribute('data-object-id')
                loading.show({text: '正在删除，请稍后...', fullscreen: true })
                if (objectId) $api.book.handleDelete(objectId).then(() => {
                    loading.hide()
                    message.show({
                        text: '删除成功！',
                        type: 'success'
                    })
                    document.querySelector(`#${id}`)?.remove()
                })
            }
        })
        fileEl && (fileEl.onchange = (e: Event) => {
            let target = e.target as any
            let files = [...target.files]
            files.map(async el => {
                let book:any = Epub(el);
                book.ready.then(async () => {
                    loading.show()
                    let coverUrl = await book.coverUrl()
                    let result = await fetch(coverUrl).then(res => res.blob())
                    let reader = new FileReader()
                    reader.readAsDataURL(result)
                    reader.onload = () => {
                        $api.book.upload(el.name, el, {cover: { base64: reader.result }, onprogress: (data:any) => {
                            loading.onprogress(data)
                        }}).then((data:any) => {
                            const { attributes, id } = data
                            console.log(attributes, 'data');
                            localforage.setItem('book_' + el.name, el.arrayBuffer())
                            let alink = document.createElement('div') as HTMLDivElement
                            let removeBtnEl = bookEl.querySelectorAll('.remove-btn')
                            alink.id = `book${removeBtnEl.length+1}`
                            alink.setAttribute('class', 'w-full overflow-hidden')
                            alink.innerHTML = `<a href='/eBook/${el.name.split('_')[0]}'><div class='w-full  overflow-hidden'  title='${attributes.title}'>
                            <img src='${attributes.img}' class="h-[230px] sm:h-[260px] lg:h-[160px] w-full" alt={item.title} />
                            <h3 class="text-center line-clamp-1 mt-2">${el.name.split('_')[0]}-${el.name.split('_')[1]}</h3></div></a><div class="flex justify-center my-1"><button class="remove-btn border px-1 rounded-md text-[var(--color-accent)] border-[var(--color-accent)] cursor-pointer" data-object-id=${id} data-id="book${removeBtnEl.length+1}">删除</button></div>`
                            bookEl.prepend(alink)
                            message.show({
                                text: '上传成功！',
                                type: 'success'
                            })
                            loading.hide()
                            fileEl.value = ''
                        })
                    }
                })
            })
        })
    })
</script>