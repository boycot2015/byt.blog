---
import { render, getCollection } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
export const getStaticPaths = (async () => {
	const allbooks = await getCollection("ebook");
	return allbooks.map((book) => ({
		params: { slug: book.data.title },
		props: { book },
	}));
}) satisfies GetStaticPaths;
export type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { book } = Astro.props;
const meta = {
	description: book.data.description,
	title: book.data.title,
};

---
<PageLayout meta={{comment: false, ...meta }}>
	<!-- 将消息存储为数据属性。 -->
	<book-component data-book={JSON.stringify(book)}>
		<div class="flex flex-col">
			<div class="flex justify-between items-center pb-2 border-b mb-4 border-b-[var(--color-accent)]">
				<h3 class="text-center flex-1 text-xl">{book.data.title}</h3>
				<div class="cursor-pointer add-label-btn">+加入书签</div>
			</div>
			<div class="flex justify-between">
				<select class="w-[40%]" id="columns">
					<option label="请选择"></option>
				</select>
				<div>跳转第
					<input class="border pager rounded-md mx-2 text-center w-[60px]" type="text" />章
				</div>
			</div>
			<div class="flex justify-center items-center">
				<div class="w-[100%] !text-[var(--color-accent)] h-[100vh] overflow-hidden" id="book">
					<div class="text-center my-20">资源加载中，请稍后...</div>
				</div>
			</div>
			<div class="page flex justify-between">
				<div class="btn-prev cursor-pointer hover:text-[var(--color-accent)]">← 上一页</div>
				<div class="flex w-[60%]">
					书签：<select id="marks">
						<option label="请选择"></option>
					</select>
				</div>
				<div class="btn-next cursor-pointer hover:text-[var(--color-accent)]">下一页 →</div>
			</div>
		</div>
	</book-component>
</PageLayout>
<script>
	import Epub from 'epubjs'
	import localforage from 'localforage'
	class BookComponent extends HTMLElement {
		data: any
		book: any
		rendition: any
		bookmarks: any[]
		columns: any[]
		columnsEl: HTMLSelectElement
		marksEl: HTMLSelectElement
		async connectedCallback() {
			const bookContainer = document.getElementById('book') as HTMLDivElement;
			// 从 data（数据）属性中读取消息。
			const data = JSON.parse(this.dataset.book as string);
			let bookdata = await localforage.getItem('book_' + data.data.title)
			let bookmarks = await localforage.getItem('book_marks_' + data.data.title) as any || []
			if (!bookdata) {
				let file = await fetch(data.data.file).then((res) => res.arrayBuffer())
				localforage.setItem('book_' + data.data.title, file)
				bookdata = await localforage.getItem('book_' + data.data.title)
			}
			let book = Epub(bookdata);
			bookContainer.innerHTML = ''
			// 读取EPUB文件
			await book.loaded;
			// 创建一个 Rendition，并指定要渲染 EPUB 的 HTML 元素
			const rendition = book.renderTo(bookContainer, {
				flow: "paginated", // paginated、scrolled-doc
				width: '100%',
				height: '100%',
				stylesheet: 'src/styles/global.css',
				spread: true,
				// defaultDirection: '',
				// minSpreadWidth: 600,
				allowScriptedContent: true
			});
			this.data = data
			this.book = book
			this.rendition = rendition
			this.bookmarks = bookmarks
			// console.log(this.rendition, this.book, 'book');
			book.ready.then(() => {
				// 加载目录
				this.loadColumns()

				// 加载书签
				this.loadMarks()

				// 加载页面
				rendition.display((bookmarks[0]?.start?.cfi)|| 2);

				// 事件处理
				let prevBtn = this.querySelector('.btn-prev') as HTMLDivElement
				let nextBtn = this.querySelector('.btn-next') as HTMLDivElement
				let pager = this.querySelector('.pager') as HTMLInputElement
				let addLabel = this.querySelector('.add-label-btn') as HTMLInputElement

				prevBtn.onclick = () => this.pageChange()
				nextBtn.onclick = () => this.pageChange('next')
				pager.onblur = () => this.pageChange('pager')

				// 加入书签
				addLabel.onclick = () => this.addMark()

				// 切换目录
				this.columnsEl.onchange = (e) => this.columnsChange(e)

				// 切换书签
				this.marksEl.onchange = (e) => this.changeMark(e)
			})
		}
		loadColumns () {
			let columnsEl = this.querySelector('#columns') as HTMLSelectElement
			let columns = this.book.navigation.toc
			const covert = (item) => {
				let index = +this.book.navigation.tocByHref[item.href] + 2
				if (item.id !== item.href) {
					if (item.id.split('_')[1]) {
						index = +item.id.split('_')[1] + +this.book.navigation.tocById[item.id]
						if (item.parent) {
							index = +item.parent.split('_')[1] + (+this.book.navigation.tocById[item.id] + 2)
						}
					} else {
						index = +this.book.navigation.tocById[item.id]
						if (item.parent) {
							index = (+this.book.navigation.tocById[item.id] + 2)
						}
					}
				}
				return {
					...item, label: item.label?.replace(/\n/g, '').split(' ').filter(el => el).slice(-2).join(' '),
					index
				}
			}
			columns = columns.reduce((curr, next) => next.subitems?.length ? curr.concat(next.subitems.map(covert)) : curr.concat(covert(next)), [])
			columns.filter(el => el.index).map(el => {
				let optionEl = document.createElement('option') as HTMLOptionElement
				optionEl.label = el.label
				optionEl.value = el.index
				columnsEl.appendChild(optionEl)
			})
			columnsEl.value = this.bookmarks[0]?.start.index || ''
			this.columns = columns
			console.log("locations:", columns, this.book.navigation)
			this.columnsEl = columnsEl
		}
		loadMarks () {
			let marksEl = this.querySelector('#marks') as HTMLSelectElement
			this.bookmarks.filter(el => el.label).map(el => {
				let optionEl = document.createElement('option') as HTMLOptionElement
				optionEl.label = el.label
				optionEl.value = el.start.cfi
				marksEl.appendChild(optionEl)
			})
			marksEl.value = this.bookmarks[0]?.start.cfi || ''
			this.marksEl = marksEl
		}
		addMark () {
			let mark = {
				...this.rendition.location,
				label: this.columns.find(el => el.href.split('#')[0] === this.rendition.location.start?.href)?.label + '_' + rendition.location.start?.displayed.page
			}
			// console.log(this.columns, this.rendition.location.start, mark, 'rendition.location.start');
			let has = this.bookmarks.find(el => el.label === mark.label)
			!has && this.bookmarks.unshift(mark)
			let optionEl = document.createElement('option') as HTMLOptionElement
			optionEl.label = mark.label
			optionEl.value = mark.start.cfi
			this.marksEl.appendChild(optionEl)
			localforage.setItem('book_marks_' + this.data.title, this.bookmarks)
			alert(has ? '书签已存在': '添加成功')
		}
		changeMark (e) {
			let target = e.target as any
			this.rendition.display(target.value || '')
			let has = this.bookmarks.find(el => el.start.cfi === target.value)
			let hasIndex = this.bookmarks.findIndex(el => el.start.cfi === target.value)
			let old = this.bookmarks[0]
			if (has) {
				this.bookmarks.splice(0, 1, has)
				this.bookmarks.splice(hasIndex, 1, old)
				localforage.setItem('book_marks_' + this.data.title, this.bookmarks)
				this.columnsEl.value = has.start.index || ''
				this.toTop()
			}
		}
		pageChange (type = 'prev') {
			let pager = this.querySelector('.pager') as HTMLInputElement
			if (type === 'pager') {
				if (pager.value) {
					this.rendition.display(pager.value)
					this.columnsEl.value = pager.value
					this.toTop()
				}
				pager.value = ''
				return
			}
			this.rendition[type]()
			this.toTop()
		}
		columnsChange (e) {
			let target = e.target as any
			this.rendition.display(+target.value || '')
			this.toTop()
		}
		toTop () {
			document.body.scrollIntoView({ behavior: 'smooth' })
		}
	}
customElements.define('book-component', BookComponent)
  