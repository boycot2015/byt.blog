---
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";
const meta = {
	description: "I'm boycot，An Front end developer",
	title: "关于",
	comment: true
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">About me</h1>
	<div class="prose prose-sm prose-cactus max-w-none pb-2 mb-4 border-b border-[var(--color-bg)]">
		<p>
			Hi, I’m boycot，a web developer and sometime develop some applications.
		</p>
		<ul class="list-inside list-disc" role="list">
			<li>🔨 I’m currently use Vue.js, React.js, Svelte.js, Astro.js, JavaScript </li>
			<li>📮 How to reach me: <a href="mailto:boycot2017@163.com">boycot2017@163.com</a></li>
			<li>to be continued ...</li>
		</ul>
		<h3 class="title">Languages and Tools:</h3>
		<div class="flex space-x-2">
			<code><img height="20" src="https://img.shields.io/badge/Vue-lightgreen"></code>
			<code><img height="20" src="https://img.shields.io/badge/React-skyblue"></code>
			<code><img height="20" src="https://img.shields.io/badge/Astro-black"></code>
			<code><img height="20" src="https://img.shields.io/badge/Svelte-red"></code>
		</div>
		<p>
			Clone or fork my <a
				class="cactus-link inline-block"
				href={siteConfig.social.github}
				rel="noreferrer"
				target="_blank">repo</a
			> if you like me!
		</p>
		<p>I’m looking for new chance，read：<a href="/links/个人简历/">my profile </a></p>
	</div>
</PageLayout>
