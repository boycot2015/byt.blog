---
import { render, getCollection } from "astro:content";
import PostLayout from "@/layouts/BlogPost.astro";

const allLinks:any = await getCollection("link", ({ data }) => data.page);
const { Content } = await render(allLinks[0]);

---
<style>
	:global(.link-content .links) {
		ul {
			overflow: hidden;
			clear: both;
			padding-inline-start: 0;
			display: grid;
			/* grid-column: 1; */
			grid-template-columns: repeat(auto-fill, 100px);
			gap: 20px;
			li {
				/* margin-bottom: 10px;
				margin-right: 10px; */
				margin: 0;
				list-style: none;
				padding-inline-start: 0;
				p {
					margin: 0;
				}
				a {
					display: flex;
					flex-direction: column;
					justify-content: center;
					align-items: center;
					&:hover {
						color: var(--color-accent);
						text-decoration-color: var(--color-accent);
					}
				}
			}
			@media screen and (max-width: 360px) and (min-width: 344px) {
				grid-template-columns: repeat(auto-fill, 90px);
			}
			@media screen and (max-width: 374px) and (min-width: 360px) {
				grid-template-columns: repeat(auto-fill, 96px);
			}
			@media screen and (max-width: 412px) and (min-width: 376px) {
				grid-template-columns: repeat(auto-fill, 106px);
			}
			@media screen and (max-width: 414px) and (min-width: 412px) {
				grid-template-columns: repeat(auto-fill, 112px);
			}
			@media screen and (max-width: 429px) and (min-width: 414px) {
				grid-template-columns: repeat(auto-fill, 114px);
			}
			@media screen and (max-width: 460px) and (min-width: 430px) {
				grid-template-columns: repeat(auto-fill, 118px);
			}
			@media screen and (max-width: 750px) and (min-width: 540px) {
				grid-template-columns: repeat(auto-fill, 112px);
			}
		}
		ul img {
			width: 100%;
			min-height: 100px;
			/* background-color: #ccc; */
			border-radius: 5px;
			margin: 0 auto 5px;
		}
	}
</style>
<PostLayout post={allLinks[0]} meta={{comment: true }}>
	<div class="link-content">
		<Content />
	</div>
</PostLayout>
