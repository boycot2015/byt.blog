---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import type { HTMLTag, Polymorphic } from "astro/types";
import { siteConfig } from "@/site.config";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
---
<Tag class="w-full">
	<a class="flex justify-between w-full" transition:name={`title-${post.id}`} data-astro-prefetch href={`/posts/${post.id}/`}>
		{<img width="160" height="100" transition:name={`img-${post.id}`} class="mr-4" src={post.data.thumbImg||post.data.img || siteConfig.url + `/og-image/${post.id}.png`}/>}
		<div class="flex flex-col flex-1">
			<h3 class="line-clamp-1 mb-2 text-xl">{post.data.draft && <span class="text-red-500">(草稿) </span>}{post.data.title}</h3>
			<p class="line-clamp-2 mb-2 ">{post.data.description||post.data.desc}</p>
			<div class="time">
				发布时间：
				<FormattedDate
					class="min-w-30 font-semibold text-gray-600 dark:text-gray-400"
					date={post.data.publishDate||post.data.date}
				/>
			</div>
		</div>
	</a>
</Tag>
{withDesc && <q class="line-clamp-3 italic">{post.data.description}</q>}
