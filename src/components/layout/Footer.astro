---
import { menuLinks, siteConfig } from "@/site.config";
// export const partial = true;
const year = new Date().getFullYear();
---

<footer>
	<div class="mt-auto flex w-full flex-col items-center justify-center gap-y-2 pt-16 sm:pt-20 pb-4 text-center align-top font-semibold text-gray-600 sm:flex-row sm:justify-between sm:text-xs dark:text-gray-400">
		<div class="me-0 sm:me-4 flex items-center">
			<span class="flex mr-2 items-center justify-between text-global-text"><svg 
				xmlns="http://www.w3.org/2000/svg" 
				viewBox="0 0 24 24" 
				fill="none"
				stroke="currentColor" 
				stroke-width="2.2"
				class="inline-block h-5 w-5 mr-1"
			>
				<path 
					stroke-linecap="round" 
					stroke-linejoin="round" 
					d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" 
				/>
			</svg>{siteConfig.title}</span>
			<span class="flex-2">Powered by {siteConfig.author}
				&copy; {year}.</span>
		</div>
		<nav
			aria-labelledby="footer_links"
			class="flex gap-x-2 sm:gap-x-0 sm:divide-x sm:divide-gray-500"
		>
			<p id="footer_links" class="sr-only">More on this site</p>
			{
				menuLinks.map((link) => (
					!link.hideInFooter && <a class="hover:text-[var(--color-accent)] px-4 py-2 hover:underline sm:py-0" href={link.path}>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
	<div class="flex text-center items-center justify-center flex-wrap gap-y-1 pb-3">
		<a href="https://beian.miit.gov.cn/#/Integrated/index" target="_blank"><img style="margin-right:5px;" title="粤ICP备18002072号" src="https://img.shields.io/badge/%E7%B2%A4ICP%E5%A4%87-18002072%E5%8F%B7-red" /></a>
		<img style="margin-right:5px;" src="https://img.shields.io/badge/framework-astro-blue" /><img style="margin-right:5px;" src="https://img.shields.io/badge/platform-vercel-black" /><img style="margin-right:5px;" src="https://img.shields.io/badge/node-%3E%3D18.x-darkgreen" />
	</div>
</footer>
<script is:inline src="https://hm.baidu.com/hm.js?a2a4a7fe7d81b1bba128d92e6e1c4c91"></script>
<script defer src="https://byt-analytics.pages.dev/analytics.min.js" data-website-id="astro-blog"></script>