---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
// import { ViewTransitions } from "astro:transitions";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import BackTotop from "@/components/BackTotop.astro";
import Aplayer from "@/components/Aplayer.astro";
import ValineComment from "@/components/ValineComment.astro";

interface Props {
	meta: SiteMeta;
}
const {
	meta: { articleDate, description = siteConfig.description, ogImage, title, comment },
} = Astro.props;

const anim = {
  	old: {
		name: 'pageAnimate',
		duration: '0.3s',
		easing: 'ease-in-out',
		direction: 'reverse',
	},
	new: {
		name: 'pageAnimate',
		duration: '0.3s',
		easing: 'ease-in-out',
	},
};
const customTransition = {
  forwards: anim,
  backwards: anim,
};
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		<!-- <ViewTransitions fallback="none"/> -->
	</head>
	<body
		class="bg-global-bg text-global-text mx-auto flex min-h-screen max-w-4xl flex-col px-4 pt-4 sm:pt-16 font-mono text-sm font-normal antialiased sm:px-8"
	>
		<ThemeProvider />
		<SkipLink />
		<Header />
		<!-- transition:animate={customTransition} -->
		<main id="main" class="min-h-[calc(100vh-320px)] sm:min-h-[calc(100vh-380px)]" transition:animate={customTransition}>
			<slot />
			<div class="comment mt-4" class:list={{'hidden': !comment}}>
				<ValineComment comment={comment} />
			</div>
		</main>
	</body>
	<Footer />
	<BackTotop />
	<Aplayer />
</html>
<style is:global>
	@keyframes pageAnimate {
	  0% {
		opacity: 0;
		transform: translateY(10px);
	  }
	  100% {
		opacity: 1;
		transform: translateY(0);
	  }
	}
</style>